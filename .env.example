# Copy to .env.local to connect the app to Supabase.
# Leave these empty to run with the built-in sample company (no database; changes last until reload).
#
# Local Supabase (needs Docker): run `npx supabase start`, then `npm run db:reset`,
# and copy the API URL and the anon (or publishable) key it prints.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
